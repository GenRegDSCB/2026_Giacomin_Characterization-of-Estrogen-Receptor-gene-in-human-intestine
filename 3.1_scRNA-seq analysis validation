summary <- total %>%
  group_by(gene, annotation, `Region code`, category, tissue_type) %>%
  summarise(
    pct_expr = (sum(expression > 0)/n())*100,
    mean = log1p(mean(expression)), 
    n = n(),
    n_pos = sum (expression > 0),
    expression = sum (expression),
    .groups = "drop"
  ) %>%
  filter(n >= 20)

ggplot(summary, aes(gene, annotation))+
  geom_point(aes(size = pct_expr, colour = (mean)))+
  scale_color_viridis_c(option = "viridis",
                        limits = c(0.0004, 0.35))+
  facet_grid(category ~ `Region code`, 
             scales = "free_y", 
             labeller = label_wrap_gen(width = 10)
             )+
  theme_bw()+
  theme (
    axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
    strip.text.x = element_text(size = 8)
  )+
  labs (
    x = "Gene",
    y = "Cell Type",
    size = "% of Expressing cells",
    colour = "Avarage of expression"
  )+
  ggtitle ("scRNAseq analysis validation")

