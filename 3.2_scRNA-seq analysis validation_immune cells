## creation of the plot ====

c_summary <- counts %>%
  group_by(region, cell_type, gene, lineage) %>%
  summarise(
    n = n(),
    n_pos = sum(expression > 0),
    pct_expr = (sum(expression > 0)/n())*100,
    mean = log1p(mean(expression)),
    expression = sum (expression),
    .groups = "drop"
  ) %>%
  filter (n >= 15)

ggplot(c_summary, aes(x = n)) +
  geom_histogram(bins = 50) +
  scale_x_log10() +
  theme_minimal()

levels(c_summary$region)
c_summary$region <- droplevels(c_summary$region)
c_summary$region <- factor(c_summary$region, levels = c("Caecum", "Transverse", "Sigmoid"))

ggplot(c_summary, aes(gene, cell_type))+
  geom_point(aes(size = pct_expr, colour = mean))+
  scale_color_viridis_c(option = "viridis",
                        limits = c(0.0005, 0.08),
                        breaks = seq(0.00, 0.08, by = 0.015))+
  facet_grid( lineage ~ region, scale = "free_y")+
  theme_bw()+
  theme (
    axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1)
  )+
  labs (
    x = "Gene",
    y = "Cell Type",
    size = "% of Expressing cells",
    colour = "Avarage of expression"
  )+
  ggtitle ("scRNAseq analysis of colon immune lineage")

library(RColorBrewer)
