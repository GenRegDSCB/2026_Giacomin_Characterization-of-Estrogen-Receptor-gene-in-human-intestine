ggplot(tot_summary, aes(lineage, log1p(pct_expr), fill = lineage))+
  geom_boxplot()+
  scale_fill_manual(values = color)+
  facet_grid(cols=vars(organ_groups), rows=vars(gene), 
             labeller = label_wrap_gen(width = 10))+
  theme_bw()+
  theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1))+
  geom_pwc(y.position = 0.8, label = "p.signif", hide.ns = T)+
  labs(
    x = "Lineage",
    y = "Fraction of expresssing cells (%)",
    fill = "Lineage"
  )

ggplot(tot_summary, aes(lineage, pct_expr, fill = lineage)) +
  geom_boxplot() +
  facet_grid(cols = vars(organ_groups), rows = vars(gene),
             scales = "free_y",
             labeller = label_wrap_gen(width = 10)) +
  scale_fill_manual(values = color) +
  theme_bw() +
  theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1)) +
