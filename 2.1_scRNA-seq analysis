## Creation of the DotPlot ====

tot_summary <- total %>%
  group_by(cell_type, gene, lineage, tissue, organ_groups) %>%
  summarise(
    n = n(),
    n_positive = sum(expression > 0),
    pct_expr = (sum(expression > 0)/n())*100, 
    mean = (mean(expression)),
    .groups = "drop"
  ) %>%
  filter (n >= 20)

ggplot(tot_summary, aes(gene, cell_type)) +
  geom_point(aes(size = pct_expr, colour = log1p(mean))) +
  scale_colour_viridis_c(option = "viridis", 
                         limits = c(0.00005, 0.33),
                         breaks = seq(0.00, 0.30, by = 0.1)) +
  scale_size_continuous(
    breaks = seq(0, 30, by = 10),
    limits = c(0, 30)) +
  facet_grid(lineage ~ tissue, 
             scale = "free_y",
             labeller = label_wrap_gen(width = 10)) +
  theme_bw()+
  theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1), 
        strip.text = element_text(size = 7.5), axis.text.y = element_text())+
  labs (
    x = "Gene",
    y = "Cell type",
    size = "% of Expressing cells",
    colour = "Avarage of expression") +
  ggtitle ("scRNAseq analysis of ESR1 and ESR2 expression in the gastrointestinal tract")

