## Creation of the dotplot and boxplot and related to the fraction of cells expressing ESR1/2 in Bcell lineage ====

summary <- Bcell %>%
  group_by(gene, cell_type, organ_groups, tissue) %>%
  summarise(
    n = n(),
    n_pos = sum(expression > 0),
    pct_expr = (sum(expression > 0)/n())*100,
    mean = log1p(mean(expression)),
    expression = sum(expression),
    .groups = "drop"
  )%>%
  filter(n >= 10)

ggplot(summary, aes(x = n)) +
  geom_histogram(bins = 50)+
  scale_x_log10() +
  theme_minimal()

ggplot(summary, aes(gene, cell_type))+
  geom_point(aes(size = pct_expr, colour = mean)) +
  scale_color_viridis_c(limits = c(0.001, 0.30),
                        breaks = seq(0, 0.30, by = 0.05))+
  facet_wrap(~ tissue, labeller = label_wrap_gen(width = 10), nrow = 1)+
  scale_size_continuous(
    breaks = seq(0, 30, by = 10),
    limits = c(0, 30)) +
  theme_bw()+
  theme (
    axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
    strip.text.x = element_text(size = 8)
  )+
  labs(
    x = "Gene",
    y = "Cell type",
    size = "% of expressing cells",
    colour = "Avarage expression"
  )

color <- colorRampPalette(brewer.pal(9, "GnBu")) (11)
barplot(rep(1, length (color)), col = color, axes = F, border = NA)
color <- color[3:10]

ggplot(summary, aes(cell_type, pct_expr, fill = cell_type)) +
  geom_boxplot() +
  facet_grid(cols = vars(organ_groups), rows = vars(gene),
             scales = "free_y",
             labeller = label_wrap_gen(width = 10)) +
  scale_fill_manual(values = color) +
  theme_bw() +
  theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1)) +
  geom_pwc(method = "wilcox.test", label = "p.signif", hide.ns = TRUE)+
  labs(
    x = "Lineage",
    y = " Fraction of expressing cells (%)",
    fill = "Lineage"
  )

ggplot(summary, aes(cell_type, log10(expression), fill = cell_type)) +
  geom_boxplot() +
  facet_grid(cols = vars(organ_groups), rows = vars(gene),
             scales = "free_y",
             labeller = label_wrap_gen(width = 10)) +
  scale_fill_manual(values = color) +
  theme_bw() +
  theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1)) +
  geom_pwc(method = "wilcox.test", label = "p.signif", hide.ns = TRUE)+
  labs(
    x = "Lineage",
    y = "Log10 (ESR gene expression)",
    fill = "Lineage"
  )

