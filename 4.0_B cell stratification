## Creation of Barplots ====

Bcell <- Bcell %>% 
  pivot_wider(
    id_cols = c(cellID, cell_type, disease, sex, tissue, organ_groups, development_stage, age_unified), 
    names_from = "gene", 
    values_from = "expression")

Bcell <- mutate(Bcell, 
                    ESR = case_when (
                      Bcell$ESR1 > 0 &  Bcell$ESR2 > 0 ~ "ESR1_2", 
                      Bcell$ESR1 > 0 &  Bcell$ESR2 == 0 ~ "ESR1",
                      Bcell$ESR1 == 0 & Bcell$ESR2 > 0 ~ "ESR2",
                      Bcell$ESR1 == 0 & Bcell$ESR2 == 0 ~ "ESR_neg"
                    ))
Bcell$ESR <- factor (Bcell$ESR, levels = c("ESR1_2", "ESR1", "ESR2", "ESR_neg"))

Bcell2 <- subset(Bcell, !(cell_type %in% c("precursor B cell", "germinal center B cell", "plasmablast")))

summary2 <- Bcell2 %>%
  group_by(cell_type, ESR, organ_groups) %>%
  summarise(
    n = n(),
    .groups =  "drop"
  )

ggplot (summary2, aes(ESR, n, fill = cell_type)) +
  geom_bar(stat ="identity", position = "fill") +
  scale_fill_manual(values = color [3:7]) +
  facet_wrap(~ organ_groups, nrow = 1) +
  theme_bw() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1)) +
  labs(
    x = "ESR expression status",
    y = "Fraction of expressing cells",
    fill = "Cell type"
  )

