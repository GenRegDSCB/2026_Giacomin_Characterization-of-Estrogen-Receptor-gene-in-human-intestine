## addition of ESR1 and ESR2 expression values in small intestine ileum ----

intestine_ileum <- read.table("C:/Users/lorig/OneDrive/Desktop/Thesis/1_Methods_Input/Scripts/1.1_Method_ESR_expression_GTEx_analysis/gene_tpm_v11_small_intestine_terminal_ileum.gct", sep = "\t", skip = 2, header = T, check.names = F)

