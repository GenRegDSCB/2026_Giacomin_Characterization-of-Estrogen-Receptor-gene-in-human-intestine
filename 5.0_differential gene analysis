# Gisea analysis ==== 
a <- msigdbr_collections(db_species = "HS")

gsets <- msigdbr(species = "Homo sapiens", 
                 collection = "C5", 
                 subcollection = "GO:BP"
)
gsets <- gsets %>%
  split(x = .$gene_symbol, f = .$gs_name)

DEIgA <- subset(DEIgA, !(gene_symbols)%in% c("ESR1", "ESR2"))
DEIgA <- arrange(DEIgA, avg_log2FC)
ranks <- sort (DEIgA$avg_log2FC, decreasing = T)
names(ranks) <- DEIgA$gene_symbol

GSEA <- fgsea(pathways = gsets, 
                stats = ranks,
              minSize = 10,
              maxSize = 500
              )
library (data.table)
fwrite(GSEA, file="c", sep="\t", sep2=c(" ", " ", " "))

