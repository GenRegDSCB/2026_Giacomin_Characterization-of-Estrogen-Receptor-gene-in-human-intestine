# vulcano plot ====
library (ggrepel)

t <- DEIgA
t <- subset(t, !(gene_symbols %in% c("ESR1", "ESR2")))
t$diffexpressed <- "NO"
t$diffexpressed[t$avg_log2FC > 0 & t$p_val_adj < 0.05] <- "UP"
t$diffexpressed[t$avg_log2FC < 0 & t$p_val_adj < 0.05] <- "DOWN"
t$log10 <-(-log10(t$p_val_adj))

vulcano_plot <- ggplot(t, aes(x = avg_log2FC, y = -log10(p_val_adj),col = diffexpressed)) +
  geom_vline(xintercept = 0, col = "gray", linetype = 'dashed') +
  geom_hline(yintercept = -log10(0.05), col = "gray", linetype = 'dashed') + 
  geom_point(size = 2)+
  geom_text_repel(
    data = t %>% filter(-log10(p_val_adj) > 80),
    aes(label = gene_symbols),          
    color = "black",
    size = 4,
    max.overlaps = Inf,            
    box.padding = 0.4,
    segment.color = "gray50"
  ) +
  scale_color_manual(values = c("blue", "grey","red"),
                     labels = c("Downregulated", 
                                "No-significance",
                                "Upregulated"))+
  theme_bw()+
  labs(
    x = "Log2FC",
    y = "-Log10 (Pvalue adj)",
    col = "Differentially Expressed Genes"
  ) +
  theme(
    axis.title = element_text(size = 12),
    legend.title = element_text(size = 12),
    legend.text = element_text(size = 12)
  )

ggsave("volcano_plot.png", plot = vulcano_plot, width = 7, height = 6, dpi = 500)

